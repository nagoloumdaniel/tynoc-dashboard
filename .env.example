# Copier en .env.local pour le développement.
AWS_REGION=eu-west-3
# DynamoDB Local (docker compose). Laisser vide en production.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=tynoc-
# Images produits. En local : conteneur RustFS (docker compose), en production : bucket AWS.
S3_BUCKET=tynoc-images
S3_ENDPOINT=http://localhost:9000
# Facultatif : URL publique des images (CDN). Déduite du bucket sinon.
S3_PUBLIC_URL=
# Production uniquement (Vercel) : rôle IAM assumé via OIDC. Voir docs/deploiement-aws.md.
AWS_ROLE_ARN=
# Production (Vercel Cron) : secret partagé pour /api/cron/snapshot, 16 caractères minimum.
CRON_SECRET=
